# Environment variables for GoAgent
# Copy this file to .env and fill in your actual tokens

# --- LLM Configuration ---
# Pick your provider by setting the right URL + model + API key.
# For local llama.cpp: leave LLM_API_KEY empty.
# For Groq / OpenAI / any OpenAI-compatible API: set LLM_API_KEY.

# Example: local llama.cpp (default)
LLM_BASE_URL=http://127.0.0.1:8082/v1
MODEL_NAME=lfm2.5-1.2b
LLM_API_KEY=

# Example: Groq (uncomment and comment out the block above)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# MODEL_NAME=llama-3.3-70b-versatile
# LLM_API_KEY=gsk_your_groq_key_here

MAX_TOKENS=256
TEMPERATURE=0.1
MAX_ITERATIONS=5

# --- Server Configuration ---
LISTEN_ADDR=:8080

# --- Hugging Face (ASR / Whisper) ---
# Get your token from: https://huggingface.co/settings/tokens
# NEVER commit this token to git
HF_TOKEN=hf_YOUR_HUGGINGFACE_TOKEN_HERE

# --- Voice WebSocket Auth ---
# Must match the AUTH_TOKEN in the ESP32 firmware
# NEVER commit this token to git
VOICE_AGENT_TOKEN=YOUR_RANDOM_SECRET_TOKEN_HERE

# --- Voice Session ---
VOICE_SESSION_ID=voice

# --- VAD Configuration ---
VAD_THRESHOLD_DB=-40.0
VAD_SILENCE_BATCHES=32
VAD_MIN_SPEECH_BATCHES=8
MAX_VOICE_AUDIO_SEC=30
